# Copy to .env and fill in real values locally. Never commit the populated file.

AROORAA_DB_URL=jdbc:postgresql://localhost:5433/arooraa_leads
AROORAA_DB_USERNAME=arooraa_leads_app
AROORAA_DB_PASSWORD=
AROORAA_IP_HASH_SECRET=
SERVER_PORT=8090

# Optional overrides (defaults shown)
AROORAA_TRUSTED_PROXIES=
AROORAA_RATE_LIMIT_MAX_REQUESTS=5
AROORAA_RATE_LIMIT_WINDOW_MINUTES=10
AROORAA_DUPLICATE_WINDOW_MINUTES=5

# Project enquiries (AROORAA "Start a Project" flow) — independent from the demo-request
# settings above, so the two flows never share rate-limit or duplicate-detection state.
AROORAA_PROJECT_ENQUIRY_DUPLICATE_WINDOW_MINUTES=5
AROORAA_PROJECT_ENQUIRY_RATE_LIMIT_MAX_REQUESTS=5
AROORAA_PROJECT_ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=10

# Admin (internal lead management, Milestone 2C).
# Only used ONCE, on first startup, to create the first admin_users row — only takes
# effect if the table is empty. Leave unset after that. Never commit real values here.
AROORAA_ADMIN_BOOTSTRAP_EMAIL=
AROORAA_ADMIN_BOOTSTRAP_PASSWORD=
AROORAA_ADMIN_BOOTSTRAP_NAME=Admin

# Admin account recovery (Milestone 2D). Only takes effect when the app is started with
# the "admin-maintenance" Spring profile active — never during normal operation. Resets
# the password of an existing admin (by email), or creates a new one if that email
# doesn't exist yet. See docs/admin-account-recovery.md for the full procedure. Never
# commit real values here.
AROORAA_ADMIN_RESET_EMAIL=
AROORAA_ADMIN_RESET_PASSWORD=
AROORAA_ADMIN_RESET_NAME=Admin

# Set to true once the app is served over HTTPS (production, behind Nginx). Must stay
# false for plain-http local development, or the browser will silently refuse to store
# the session cookie and login will appear to succeed but not persist.
AROORAA_ADMIN_COOKIE_SECURE=false

AROORAA_ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AROORAA_ADMIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
