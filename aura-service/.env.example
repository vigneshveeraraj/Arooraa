# Copy to .env and fill in real values locally. Never commit the populated file.

AURA_DB_URL=jdbc:postgresql://localhost:5434/arooraa_aura
AURA_DB_USERNAME=arooraa_aura_app
AURA_DB_PASSWORD=
SERVER_PORT=8091

# AI providers — all disabled by default. The application starts and stays healthy with none of
# these set; ingestion simply can't run (IngestionService.ingest fails the job cleanly with
# EMBEDDING_PROVIDER_DISABLED) and no chat surface exists yet in this milestone. No real provider
# adapter ships in A0/A1 — only the interfaces and disabled/production-safe defaults. Never commit
# real API keys here when a real provider adapter is added in a later milestone.
AURA_CHAT_PROVIDER_ENABLED=false
AURA_CHAT_MODEL=
AURA_CHAT_PROVIDER_TIMEOUT_SECONDS=30

AURA_EMBEDDING_PROVIDER_ENABLED=false
AURA_EMBEDDING_MODEL=
AURA_EMBEDDING_DIMENSIONS=1536
AURA_EMBEDDING_PROVIDER_TIMEOUT_SECONDS=30

AURA_RERANKING_PROVIDER_ENABLED=false
AURA_RERANKING_MODEL=
AURA_RERANKING_PROVIDER_TIMEOUT_SECONDS=30

# Safety baseline — represented now for the next milestone's chat endpoint, not consumed by any
# code yet (no HTTP surface exists in A0/A1).
AURA_MAX_INPUT_CHARS=4000
AURA_RAW_PROMPT_LOGGING_ENABLED=false
