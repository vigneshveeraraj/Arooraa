# Copy to .env and fill in real values locally. Never commit the populated file.

AURA_DB_URL=jdbc:postgresql://localhost:5434/arooraa_aura
AURA_DB_USERNAME=arooraa_aura_app
AURA_DB_PASSWORD=
SERVER_PORT=8091

# Local knowledge bootstrap (A3.1). Off by default. When true, startup loads the approved public
# corpus from AURA_BOOTSTRAP_SOURCE_DIR through the normal import/approve/ingest/activate pipeline;
# it is idempotent, and it never indexes INTERNAL, AURA_POLICY or NEEDS_OWNER_APPROVAL documents.
# Requires a working embedding provider — it fails fast rather than indexing unsearchable content.
AURA_BOOTSTRAP_PUBLIC_KNOWLEDGE=false
AURA_BOOTSTRAP_SOURCE_DIR=knowledge-seed
AURA_BOOTSTRAP_APPROVED_BY=local-bootstrap@arooraa.com
AURA_BOOTSTRAP_EXIT_AFTER=false

# Local chat surface (A3). Off by default: with AURA_CHAT_ENABLED=false the chat API and the
# manual test page are not registered at all, so /api/v1/aura/** and /aura-test return 404.
# Enable both of these only for a local manual session — never in a deployed environment.
AURA_CHAT_ENABLED=false
AURA_CHAT_DIAGNOSTICS_ENABLED=false
AURA_CHAT_MAX_HISTORY_MESSAGES=12
AURA_CHAT_MAX_HISTORY_CHARS=6000
AURA_CHAT_MAX_RESPONSE_CHARS=2000
AURA_CHAT_MAX_SOURCES=3
AURA_CHAT_TEMPERATURE=0.6
AURA_CHAT_MAX_OUTPUT_TOKENS=600

# AI providers — all disabled by default. The application starts and stays healthy with none of
# these set; ingestion simply can't run (IngestionService.ingest fails the job cleanly with
# EMBEDDING_PROVIDER_DISABLED) and Aura answers with a natural "my language service isn't switched
# on" fallback instead of failing. Never commit real API keys here.
AURA_CHAT_PROVIDER_ENABLED=false
AURA_CHAT_PROVIDER=openai
AURA_CHAT_MODEL=gpt-4o-mini
AURA_CHAT_PROVIDER_TIMEOUT_SECONDS=30

# A2 ships one real embedding adapter (OpenAI) behind the EmbeddingProvider interface — still
# disabled by default. To enable it locally: set AURA_EMBEDDING_PROVIDER_ENABLED=true and a real
# OPENAI_API_KEY (never commit it). With enabled=true but no key, the app still starts normally —
# it falls back to the disabled provider and logs a warning (see ProviderConfiguration).
AURA_EMBEDDING_PROVIDER_ENABLED=false
AURA_EMBEDDING_PROVIDER=openai
AURA_EMBEDDING_MODEL=text-embedding-3-small
AURA_EMBEDDING_DIMENSIONS=1536
AURA_EMBEDDING_PROVIDER_TIMEOUT_SECONDS=30
# Which vector cohort ingestion writes and retrieval searches (A2.1). Bump when the provider,
# model or dimension changes, then re-embed — vectors from different generations are never mixed
# in one similarity search. 1 = A2's stub/dev vectors; 2 = the real-provider calibration cohort.
AURA_EMBEDDING_GENERATION=1
OPENAI_API_KEY=

AURA_RERANKING_PROVIDER_ENABLED=false
AURA_RERANKING_MODEL=
AURA_RERANKING_PROVIDER_TIMEOUT_SECONDS=30

# Safety baseline. max-input-chars is represented for a future chat endpoint, not consumed yet;
# raw-prompt-logging-enabled already gates HybridRetrievalService's query logging in A2.
AURA_MAX_INPUT_CHARS=4000
AURA_RAW_PROMPT_LOGGING_ENABLED=false

# Deterministic, heading-aware chunking (A2) — configurable target size/overlap, not hardcoded.
AURA_CHUNK_TARGET_CHARS=1000
AURA_CHUNK_OVERLAP_CHARS=150

# Hybrid retrieval.
AURA_RETRIEVAL_CANDIDATE_LIMIT=20
AURA_RETRIEVAL_RESULT_LIMIT=8
AURA_RETRIEVAL_RRF_K=60
# ABSOLUTE relevance thresholds (never compared against an RRF score — see EvidenceGateService).
# A2.2 values, measured with the real provider via EmbeddingCalibrationIT: positives land at
# 0.583..0.740, unrelated questions at 0.042..0.275. See application.yml for the full derivation.
AURA_EVIDENCE_STRONG_VECTOR_SIMILARITY=0.58
AURA_EVIDENCE_WEAK_VECTOR_SIMILARITY=0.30
AURA_EVIDENCE_STRONG_QUERY_TERM_COVERAGE=0.75
AURA_EVIDENCE_WEAK_QUERY_TERM_COVERAGE=0.40
