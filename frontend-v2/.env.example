# Copy the relevant line(s) to .env.local for local development. Never commit .env.local
# (it's gitignored) and never put a real production host in it.

# Production default: leave NEXT_PUBLIC_API_BASE_URL unset. The frontend then calls the
# same-origin relative path below, which Nginx proxies to the backend
# (see ops/nginx/arooraa.com.conf: /api/leads/ -> Spring Boot's /api/v1/).
# NEXT_PUBLIC_API_BASE_PATH=/api/leads

# Local development: `next dev` has no reverse proxy in front of it, so the browser must
# call the Spring Boot backend directly. Point this at wherever your local backend is
# actually running (its default local port is 8090 — see backend/.env.example's
# SERVER_PORT and backend/src/main/resources/application.yml). The backend must also have
# AROORAA_CORS_ALLOWED_ORIGINS set to this frontend's origin (see backend/.env.example) or
# the browser will block the cross-origin request.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090
