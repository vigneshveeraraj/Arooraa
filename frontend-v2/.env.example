# Copy the relevant line(s) to .env.local for local development. Never commit .env.local
# (it's gitignored) and never put a real production host in it.

# Production default: leave NEXT_PUBLIC_API_BASE_URL unset. The frontend then calls the
# same-origin relative path below, which Nginx proxies to the backend
# (see ops/nginx/arooraa.com.conf: /api/leads/ -> Spring Boot's /api/v1/).
# NEXT_PUBLIC_API_BASE_PATH=/api/leads

# Local development: `next dev` has no reverse proxy in front of it, so the browser must
# call the Spring Boot backend directly. Point this at wherever your local backend is
# actually running (its default local port is 8090 — see backend/.env.example's
# SERVER_PORT and backend/src/main/resources/application.yml). The backend must also have
# AROORAA_CORS_ALLOWED_ORIGINS set to this frontend's origin (see backend/.env.example) or
# the browser will block the cross-origin request.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090

# --- Aura (A4) ---------------------------------------------------------------------------------
# Nothing is required here for local development. `next dev` proxies /api/aura/* to aura-service
# on :8091 (see next.config.ts), so the browser only ever makes a same-origin request and no CORS
# is involved. Start aura-service with AURA_CHAT_ENABLED=true and it works.
#
# Only set this to call the backend directly instead of through the dev proxy — and if you do,
# aura-service also needs AURA_CORS_ALLOWED_ORIGINS=http://localhost:3000 or the browser will
# block it. There is no reason to prefer this; it exists so the base URL is configurable rather
# than compiled into components.
# NEXT_PUBLIC_AURA_API_BASE_URL=http://localhost:8091

# Local developer diagnostics in the Aura panel (mode, evidence level, language, tone, latency).
# OFF unless set to exactly "true", and it also needs AURA_CHAT_DIAGNOSTICS_ENABLED=true on the
# backend — a visitor-facing build must never have either. Never shows prompts, scores or
# identifiers; there is no field on the wire for them.
# NEXT_PUBLIC_AURA_DIAGNOSTICS=true

# NEVER put OPENAI_API_KEY (or any backend secret) in this file. Anything NEXT_PUBLIC_* is baked
# into the static export and readable by every visitor. The browser talks only to aura-service,
# and aura-service talks to the model provider.
